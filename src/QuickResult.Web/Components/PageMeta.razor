@inject NavigationManager Navigation

@* The head tags every page needs: a unique title and description for search results,
   a canonical address, and the Open Graph / Twitter tags link previews read. *@
<PageTitle>@Title</PageTitle>
<HeadContent>
    <meta name="description" content="@Description" />
    @if (NoIndex)
    {
        <meta name="robots" content="noindex" />
    }
    else
    {
        <link rel="canonical" href="@CanonicalUrl" />
        <meta property="og:url" content="@CanonicalUrl" />
    }
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="QuickResult" />
    <meta property="og:title" content="@Title" />
    <meta property="og:description" content="@Description" />
    <meta property="og:image" content="@PreviewImageUrl" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="QuickResult: a Result type for C# with LINQ query syntax" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:image" content="@IconUrl" />
    @if (StructuredData is not null)
    {
        @StructuredDataScript
    }
</HeadContent>

@code {
    // The wide image is what most link previews show; the summary card wants a square one.
    private static readonly string PreviewImageUrl = new Uri(SiteInfo.Origin, "og-image.png").AbsoluteUri;
    private static readonly string IconUrl = new Uri(SiteInfo.Origin, "icon-192.png").AbsoluteUri;

    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string Description { get; set; } = string.Empty;

    /// <summary>Set on pages that have no address of their own, such as the not-found page.</summary>
    [Parameter]
    public bool NoIndex { get; set; }

    /// <summary>
    /// Optional schema.org JSON-LD describing the page. It is written into the head as-is,
    /// so it must come from trusted, constant JSON (see <see cref="QuickResult.Web.StructuredData"/>).
    /// </summary>
    [Parameter]
    public string? StructuredData { get; set; }

    // Razor does not allow a literal script tag in a component, so the element is emitted as markup.
    private MarkupString StructuredDataScript =>
        new($"<script type=\"application/ld+json\">{StructuredData}</script>");

    // Always the public address without query or fragment, whichever host is serving the page.
    private string CanonicalUrl =>
        new Uri(SiteInfo.Origin, new Uri(Navigation.Uri).AbsolutePath).AbsoluteUri;
}
