@page "/examples"
@inject IExampleRegistry Registry

<PageTitle>Interactive Examples — QuickResult</PageTitle>

<article class="doc-page examples-page">
    <h1>Interactive Examples</h1>
    <p class="lead">
        Every example below executes the <strong>real QuickResult package</strong> — the same assembly
        you'd install from NuGet — compiled to WebAssembly and running in your browser.
        Edit the inputs, press <em>Run</em>, and watch the Result change tracks.
    </p>

    <nav class="example-toc">
        @foreach (var category in Registry.Categories)
        {
            <div class="example-toc-group">
                <span class="example-toc-category">@category</span>
                @foreach (var example in Registry.GetByCategory(category))
                {
                    <a href="examples#@example.Id">@example.Title</a>
                }
            </div>
        }
    </nav>

    @foreach (var category in Registry.Categories)
    {
        <section class="example-category">
            <h2>@category</h2>
            @foreach (var example in Registry.GetByCategory(category))
            {
                <ExampleRunner Example="example" />
            }
        </section>
    }
</article>
