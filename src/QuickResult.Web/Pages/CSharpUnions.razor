@code {
    private IExample? _example;

    protected override void OnInitialized()
    {
        _example = Registry.Find("union-switch").Match(e => (IExample?)e, _ => (IExample?)null);
    }

    private const string DeclarationSnippet =
        """
        // A Reading is a double, a bool, or a string. Nothing else.
        public union Reading(double, bool, string);
        """;

    private const string ExhaustiveSwitchSnippet =
        """
        string Render(Reading reading) => reading switch
        {
            double measure => $"{measure:F1}",
            bool isOn => isOn ? "on" : "off",
            string text => text
        };
        """;

    private const string ResultSwitchSnippet =
        """
        Result<int> result = ParsePositive(input);

        string text = result switch
        {
            int value => $"Got {value}",
            IError error => $"Failed: {error.Message}"
        };

        if (result is IError failure)
            Console.WriteLine(failure.Message);
        """;

    private const string CustomErrorSnippet =
        """
        string status = result switch
        {
            int value => "200",
            NotFoundError => "404",
            IError => "500"
        };
        """;

    private const string ConversionSnippet =
        """
        Result<int> ParsePositive(string text)
        {
            if (int.TryParse(text, out var number) && number > 0)
                return number;                              // becomes Success(number)

            return new Error("Not a positive integer");     // becomes Failure(...)
        }
        """;

    private const string ImplementationSnippet =
        """
        [Union]
        public sealed partial class Result<T> : Result<T>.IUnionMembers
        {
            object? IUnionMembers.Value => IsSuccess ? _value : _error;
            bool IUnionMembers.HasValue { get { ... } }               // false for a null success

            bool IUnionMembers.TryGetValue(out T value) { ... }       // read as a T, no boxing
            bool IUnionMembers.TryGetValue(out IError error) { ... }  // read as an IError

            static Result<T> IUnionMembers.Create(T value) => Success(value);
            static Result<T> IUnionMembers.Create(IError error) => Failure(error);

            // The compiler finds the union's members here, not on Result<T> itself.
            public interface IUnionMembers
            {
                object? Value { get; }
                bool HasValue { get; }
                bool TryGetValue(out T value);
                bool TryGetValue(out IError error);
                static abstract Result<T> Create(T value);
                static abstract Result<T> Create(IError error);
            }
        }
        """;
}
